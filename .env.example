# ===================================================
# Samarthya AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ===================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=Samarthya-AI
DEBUG=true

# Frontend Server
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Backend FastAPI Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000

# Framework Compatibility URLs (Vite / Next.js / React)
VITE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
REACT_APP_API_URL=http://127.0.0.1:8000

# Security & CORS Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# WhatsApp Alerts Official Channel
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb90zigATRShQNhLtm2j

# Optional AI / Integration Keys
# GEMINI_API_KEY=your_gemini_api_key_here
